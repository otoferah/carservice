{
  "name": "ferah-otomotiv-desktop",
  "version": "1.0.1",
  "description": "Ferah Otomotiv Servis Yönetim Merkezi Windows istemcisi",
  "main": "main.cjs",
  "author": "Ferah Otomotiv",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ferahotomotiv.servis",
    "productName": "Ferah Otomotiv",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Ferah-Otomotiv-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ferah Otomotiv",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
